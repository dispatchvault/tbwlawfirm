---
// Base layout: replicates the live www.tbwlawfirm.com <head> (titles and meta
// descriptions are passed through verbatim from the capture) plus local fonts,
// vendor libraries and LegalService/Organization structured data.
import sharedCss from '../styles/tbwlawfirm.shared.css?url';
import overridesCss from '../styles/overrides.css?url';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}
const { title, description, bodyClass = '' } = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/^\/index$/, '/');
const canonical = new URL(canonicalPath, Astro.site).href;

const legalService = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'TBW Law',
  description: 'Personal injury law firm in Orange County, California.',
  url: 'https://www.tbwlawfirm.com',
  telephone: '+1-949-706-7100',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1000 Newport Center Dr.',
    addressLocality: 'Newport Beach',
    addressRegion: 'CA',
    postalCode: '92660',
    addressCountry: 'US'
  },
  areaServed: 'Orange County, CA',
  priceRange: 'Free consultation'
};
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TBW Law',
  url: 'https://www.tbwlawfirm.com',
  logo: 'https://www.tbwlawfirm.com/images/ico-ted-wacker-bg.png',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-949-706-7100',
    contactType: 'customer service'
  }
};
---

<!doctype html>
<html lang="en" class="w-mod-js w-mod-ix">
  <head>
    <style is:inline>.wf-force-outline-none[tabindex="-1"]:focus{outline:none;}</style>
    <meta charset="utf-8" />
    <!-- html.js gates all JS-only collapse/hide styles; without JS every
         accordion/menu panel stays expanded and visible -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/Graphik-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Graphik-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Graphik-Semibold.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Graphik-Bold.otf" as="font" type="font/otf" crossorigin />
    <link href={sharedCss} rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="/vendor/swiper-bundle.min.css" />
    <link rel="stylesheet" type="text/css" href="/vendor/splide-core.min.css" />
    <link href={overridesCss} rel="stylesheet" type="text/css" />
    <link href="/images/ico-ted-wacker.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/ico-ted-wacker-bg.png" rel="apple-touch-icon" />
    <script type="application/ld+json" set:html={JSON.stringify(legalService)} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <!-- vendor libraries the site's own custom code depends on (self-hosted) -->
    <script is:inline src="/vendor/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/vendor/swiper-bundle.min.js" type="text/javascript"></script>
    <script is:inline src="/vendor/jquery.waypoints.min.js" type="text/javascript"></script>
    <script is:inline src="/vendor/jquery.counterup.min.js" type="text/javascript"></script>
    <script is:inline src="/vendor/jquery.mark.min.js" type="text/javascript"></script>
    <script is:inline defer src="/vendor/scrolldisable.js"></script>
    <!-- replaces the Webflow interaction runtime: nav dropdowns, mobile menu,
         accordions, scroll fade-ins, video lightbox -->
    <script is:inline defer src="/js/site.js"></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
