---
// Shared site navigation (markup in nav.html). Current-page markers
// (aria-current="page" + is-current) are applied per URL at build time.
// `idOffset` shifts the nav-dropdown-toggle-N/nav-dropdown-list-N ids so a
// page can embed the nav twice without duplicate ids (/blog does).
import navHtml from './nav.html?raw';
import { markCurrent } from '../lib/current';

interface Props {
  idOffset?: number;
}
const { idOffset = 0 } = Astro.props;

let html = markCurrent(navHtml, Astro.url.pathname);
if (idOffset) {
  html = html.replace(
    /nav-dropdown-(toggle|list)-(\d+)/g,
    (_m, kind, n) => `nav-dropdown-${kind}-${Number(n) + idOffset}`
  );
}
---

<Fragment set:html={html} />
