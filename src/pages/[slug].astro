---
// Practice-area template. All ten practice pages share this template; the
// varying sections (hero, three content sections, optional FAQ, resources
// heading) live in src/data/practice-areas.json. Shared sections are the
// .html snippets under src/components/practice/.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import data from '../data/practice-areas.json';
import testimonialsHtml from '../components/practice/testimonials.html?raw';
import sliderHtml from '../components/practice/slider.html?raw';
import resourcesTpl from '../components/practice/resources.html?raw';
import tailHtml from '../components/practice/tail.html?raw';

export function getStaticPaths() {
  return Object.keys(data).map((slug) => ({ params: { slug } }));
}

const entry = data[Astro.params.slug];
const resourcesHtml = resourcesTpl.replace('__HEADING__', entry.resourcesHeading);
---

<Base title={entry.title} description={entry.description} bodyClass={entry.bodyClass}>
  <Nav />
  <Fragment set:html={entry.hero} />
  <Fragment set:html={entry.content03} />
  <Fragment set:html={entry.content02} />
  <Fragment set:html={entry.content17} />
  <Fragment set:html={testimonialsHtml} />
  <Fragment set:html={sliderHtml} />
  {entry.faq && <Fragment set:html={entry.faq} />}
  <Fragment set:html={resourcesHtml} />
  <Footer />
  <Fragment set:html={tailHtml} />
</Base>
