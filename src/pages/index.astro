<script is:inline>
document.addEventListener("DOMContentLoaded", function() {
    // Find all instances of .nav-links-wrapper within the document
    var navLinksWrappers = document.querySelectorAll('.nav-links-wrapper');

    // Loop through all .nav-links-wrapper elements found
    navLinksWrappers.forEach(function(navLinksWrapper) {
        // Find the closest parent .menu-desktop
        var menuDesktop = navLinksWrapper.closest('.menu-desktop');

        // Handle the mouse enter event
        navLinksWrapper.addEventListener('mouseenter', function() {
            menuDesktop.classList.add('active'); // Add 'active' class on hover
        });

        // Handle the mouse leave event
        navLinksWrapper.addEventListener('mouseleave', function() {
            menuDesktop.classList.remove('active'); // Remove 'active' class when not hovering
        });
    });
});


</script>
