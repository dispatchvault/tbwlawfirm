oading="eager" alt="" class="origanitation-image"></div></div></div><div class="trust-logos-inner w-dyn-list"><div role="list" class="collection-list-6 w-dyn-items"><div role="listitem" class="is-black-white w-dyn-item"><img src="/images/CAALA-Logo_g.png" loading="eager" alt="" class="origanitation-image"></div><div role="listitem" class="is-black-white w-dyn-item"><img src="/images/OCTLA-Logo_g.png" loading="eager" alt="" class="origanitation-image"></div><div role="listitem" class="is-black-white w-dyn-item"><img src="/images/ABOTA-Logo_g.jpg" loading="eager" alt="" class="origanitation-image"></div><div role="listitem" class="is-black-white w-dyn-item"><img src="/images/Gerry-Spence-Logo_g.jpg" loading="eager" alt="" class="origanitation-image"></div><div role="listitem" class="is-black-white w-dyn-item"><img src="/images/OCBA-Logo_g.png" loading="eager" alt="" class="origanitation-image"></div></div></div></div></div><div class="trust-logos__js w-embed w-script"><script is:inline>
  document.addEventListener("DOMContentLoaded", (event) => {
    $('.trust-logos-inner').each(function () {
      var totalWidth = 0;
      var gap = 30;

      $(this).find('.origanitation-image').each(function () {
        totalWidth += $(this).outerWidth();
      });

      totalWidth += ($(this).find('.origanitation-image').length - 1) * gap;
      
      $(this).css('min-width', totalWidth + 'px');

      var wrapperWidth = totalWidth * 3 + 30;
      $(this).closest('.trust-logos-wrapper').css('width', wrapperWidth + 'px');

      var windowWidth = $(window).width();

      var transformDistance = ((wrapperWidth - windowWidth) / wrapperWidth) * 100;

      if (transformDistance <= 0) {
        $(this).closest('.trust-logos-wrapper').css({
          'animation': 'none'
        });
        return;
      }

      var style = document.createElement('style');

      var speedFactor = 300;
      var animationDuration = Math.round(wrapperWidth / speedFactor) + 30;

      var animationCSS = `
        @keyframes slideLeft {
          0% {
            transform: translate(0px, 0px);
          }
          100% {
            transform: translate(-${Math.abs(transformDistance)}%, 0px);
          }
        }
      `;
    
      style.innerHTML = animationCSS;
      document.head.appendChild(style);

      $(this).closest('.trust-logos-wrapper').css({
        'animation': `slideLeft ${animationDuration}s linear infinite`
      });
    });
  });
</script></div></section><section class="section change"><div class="container__01"><div class="center-wrapper"><h2 class="h2-heading fade-up">TBW By The Numbers</h2><div class="numbers-wrapper"><div class="numbers-item"><div class="number-item__number"><span class="counterup">100</span>+</div><p class="paragraph__19 numbers">Million in case verdicts and settlements</p></div><div class="numbers-item"><div class="number-item__number"><span class="counterup">35</span></div><p class="paragraph__19 numbers">Years of practice helping victims</p></div><div class="numbers-item"><div class="number-item__number"><span class="counterup">100</span>K</div><p class="paragraph__19 numbers">Victims served and justice prevailed</p></div></div><div class="bottom-wrapper"><div data-animation="fade-in-up" class="paragraph__22">We’re here to help! Reach out and speak to a TBW attorney.</div><a href="/contact-us" class="button main is--orange w-inline-block"><div class="button__wrapper"><div>GET FREE CONSULTATION</div><div class="button__arrow is--new w-embed"><svg width="23" height="21" viewBox="0 0 23 21" fill="none" xmlns="http://www.w3.org/2000/svg">
