}</script></a></div></div></div></section><section class="section content-02 orange"><div class="flexbox-wrapper c-right"><div class="video-image-wrapper"><img src="/images/bakerfam.png" loading="lazy" sizes="(max-width: 767px) 90vw, (max-width: 991px) 80vw, 51vw" srcset="/images/bakerfam-p-500.png 500w, /images/bakerfam.png 738w" alt="" class="video-image"><a href="#" class="video-button-wrapper inline-block lightbox-link" aria-label="open lightbox" aria-haspopup="dialog"><img src="/images/Group-49.svg" loading="lazy" alt="" class="video-button-icon"><script is:inline type="application/json" class="lightbox-data">{
  "items": [
    {
