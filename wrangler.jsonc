{
  // Cloudflare Pages project (Git integration: build `npm run build`,
  // output dist/). This file is the source of truth for the project's
  // non-secret settings.
  //
  // Domains: www.tbwlawfirm.com is a CNAME at GoDaddy pointing to the
  // project's pages.dev address; tbwlawfirm.com is forwarded to www by
  // GoDaddy. DNS (and the firm's Microsoft 365 email) stays at GoDaddy.
  //
  // functions/ handles /api/forms (website forms) and /media/* (Range
  // support for the hero video); everything else is static from dist/.
  //
  // RESEND_API_KEY, FORM_NOTIFY_TO, FORM_NOTIFY_FROM and FORM_CONFIRM_FROM
  // are encrypted variables in the Pages dashboard (this repo is public).
  "name": "tbwlawfirm-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-01"
}
