{
  // Cloudflare Workers config — static site served from the Astro build.
  // The Workers Builds git integration runs `npm run build` then
  // `npx wrangler deploy`; this file tells that deploy what to publish.
  "name": "tbwlawfirm",
  "compatibility_date": "2026-08-01",
  // worker/index.js adds HTTP Range (206) support for the hero video, which
  // Safari/iOS require; only /media/* runs through it
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"],
    // serve dist/404.html for unknown paths (parity with the live site's 404)
    "not_found_handling": "404-page"
  }
}
