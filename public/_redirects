# 301s for retired URLs from the previous site (Cloudflare Workers static
# assets honor this file)

# the old sitemap lived at /sitemap.xml; Astro emits sitemap-index.xml
/sitemap.xml /sitemap-index.xml 301

# old starter/template pages — not carried over
/template-pages/* / 301
/template-pages / 301
/template-* / 301

# /get-started was a dead URL on the old site
/get-started /contact-us 301

# old category pages were empty template shells; the blog filter handles
# ?category= deep links client-side (public/js/site.js)
/category/recent-news /blog?category=Recent+News 301
/category/case-news /blog?category=Case+News 301
/category/speaking-engagements /blog?category=Speaking+Engagements 301
/category/events-sponsorship /blog?category=Events+%26+Sponsorship 301
/category/education /blog?category=Education 301
/category/videos /blog?category=Videos 301
/category/* /blog 301

# old post URLs used /post/*; belt & braces
/post/* /blog/:splat 301
